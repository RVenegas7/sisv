# =============================================================================
# Credenciales del sistema legado SIS/LAR1 (Oracle 10g, openSUSE 11.4)
# -----------------------------------------------------------------------------
# Copiar a "credenciales.env" y completar los valores reales.
# NUNCA versionar credenciales.env (ver .gitignore raiz: legancy_conf/*.env).
# Cargar con: set -a; source credenciales.env; set +a   (o con conectar_legacy.sh)
# =============================================================================

# --- Acceso SSH al servidor openSUSE 11.4 -----------------------------------
SISV_SSH_HOST=<ip-o-hostname-del-servidor>
SISV_SSH_USUARIO=oracle
SISV_SSH_PUERTO=22

# --- Variable(s) Oracle dentro del servidor (usuario oracle) ----------------
ORACLE_HOME=</ruta/a/oracle/home>
ORACLE_SID=<SID-del-sistema-por-ej-SISLAR1>
NLS_LANG=AMERICAN_AMERICA.WE8MSWIN1252

# --- Conexión sqlplus --------------------------------------------------------
# Usuario/clave de aplicación (completar), o definir SQLPLUS_CONEXION
# (ej. "/ as sysdba") para privilegios DBA implícitos como el usuario oracle.
SQLPLUS_USUARIO=<usuario>
SQLPLUS_CLAVE=<clave>
# SQLPLUS_CONEXION="/ as sysdba"