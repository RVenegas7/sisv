# Entorno del contenedor SISV. Copiar a docker/sisv.env (ignorado por git) y ajustar.
#
#   cp docker/sisv.env.example docker/sisv.env
#   ./docker/levantar.sh
#
# La aplicación se sirve por HTTP en la red local; si algún día va por HTTPS, poner
# DJANGO_COOKIE_SECURE=1.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=0
# Generar una: ./.venv/bin/python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR-ESTA-CLAVE
# '*' permite entrar por la IP de la red local (el API exige sesión, no es un acceso abierto).
DJANGO_ALLOWED_HOSTS=*
# Orígenes que pueden enviar formularios (login/POST). Poner la IP y el puerto reales.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8020,http://127.0.0.1:8020,http://192.168.5.202:8020
# 0 = cookie de sesión también por HTTP (necesario en la LAN sin HTTPS).
DJANGO_COOKIE_SECURE=0

# --- Base de datos (contenedor sis_postgres_dev ya existente) ----------------
DB_HOST=host.docker.internal
DB_PORT=5436
DB_NAME=sis_salud_db
DB_USER=sis_user
DB_PASSWORD=sis_password

# --- Servidor ---------------------------------------------------------------
PUERTO=8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
# 1 = siembra organizaciones/usuarios demo al arrancar (solo la primera vez hace falta).
SISV_SEMBRAR_DEMO=0
